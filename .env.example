# Configurações do Gateway Unificado (SSO)
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0

# Segredo compartilhado HMAC-SHA256 para Single Sign-On (SSO) entre Gateway, SPD, ED e Sistema-ETS
SSO_SECRET=dda44fc86d93b0f196a4ad1612a17e9cfd451e3f29f9e25ad3bec3fab02030df82765460ededd62e84ff65d54f179d94

# URLs dos 3 sistemas (usadas pelo Gateway para autenticação e redirecionamento)
SPD_URL=http://localhost:3000
ED_URL=http://localhost:3001
ETS_URL=http://localhost:8000

# Credenciais do Administrador mestre do Gateway (fallback caso os sistemas estejam offline)
GATEWAY_ADMIN_NAME=Administrador Unificado
GATEWAY_ADMIN_USER=admin@spd.local
GATEWAY_ADMIN_SIAPE=admin
GATEWAY_ADMIN_PASS=admin123
